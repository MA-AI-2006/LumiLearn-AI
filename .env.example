# =====================================================================
# LUMILEARN AI - ENVIRONMENT VARIABLES FOR VERCEL & LOCAL DEPLOYMENT
# =====================================================================

# ---------------------------------------------------------------------
# 1. REQUIRED SERVER VARIABLES (Add in Vercel > Settings > Environment Variables)
# ---------------------------------------------------------------------
# GEMINI_API_KEY: Required for AI note generation, tutor chat, quizzes,
# flashcards, mathematical explanations, and document translation.
# Obtain a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ---------------------------------------------------------------------
# 2. OPTIONAL GENERAL VARIABLES
# ---------------------------------------------------------------------
# APP_URL: The public URL of your Vercel deployment (e.g., https://lumilearn.vercel.app).
APP_URL="https://your-deployment.vercel.app"

# NODE_ENV: Set automatically by Vercel to "production".
NODE_ENV="production"

# ---------------------------------------------------------------------
# 3. OPTIONAL CLIENT FIREBASE VARIABLES (Prefixed with VITE_)
# ---------------------------------------------------------------------
# LumiLearn includes a pre-configured Firebase project by default.
# If you wish to connect your own Firebase project, specify these variables.
# Vite bakes any variable starting with VITE_ into the client bundle.
# VITE_FIREBASE_API_KEY="AIzaSy..."
# VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-project-id"
# VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
# VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
# VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
